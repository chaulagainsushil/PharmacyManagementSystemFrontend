# ─────────────────────────────────────────────────────────────
# PMS Frontend — Default environment variables
# Overridden by .env.local (development) or .env.production
# ─────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5259

# Application display name shown in the browser tab and UI
NEXT_PUBLIC_APP_NAME=PharmaCare PMS

# Application version shown in the sidebar
NEXT_PUBLIC_APP_VERSION=1.0.0
